# FlashWatch settings. Copy this file to flashwatch.env (same folder), fill in your own values, and never
# commit it (.gitignore already excludes *.env). Lines are KEY=value; values already set in your shell win.
# README.md, "Get the data and keys", says where each one comes from.

# --- Needed to rebuild the data and models ----------------------------------------------------------
# Google Earth Engine: a Cloud project registered for Earth Engine (ERA5-Land soil, rain and heat).
# Also run `earthengine authenticate` once on this machine.
EE_PROJECT=

# ECMWF Data Store (ECDS): your personal API key (the S2S extended-range reforecasts).
# Accept the S2S dataset licence on its ECDS page first. A Copernicus CDS key also works.
CDSAPI_KEY=
# ECDS_API_URL=https://ecds.ecmwf.int/api

# USDA NASS Quick Stats: free API key (county crop acres, yields, prices).
NASS_API_KEY=

# --- Needed for the agents (pivot finder, operator, Ask FlashWatch, voice notes, briefings) ----------
# Meta Model API key (Muse Spark, SAM 3.1, Muse Voice Transcribe).
META_API_KEY=
# META_API_BASE=https://api.meta.ai/v1      # or a local llama.cpp / vLLM server for Muse Glimmer
# META_MODEL=muse-spark-1.1
# META_TIMEOUT=120

# --- Optional: WhatsApp (plans with YES/NO buttons, questions, voice notes) -------------------------
# From a Meta developer app with the WhatsApp product (Meta's free test number is enough to try it).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE=                        # an approved one-field template, for messages FlashWatch starts
# WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_API_VERSION=v23.0

# --- Optional: pivot connectors -----------------------------------------------------------------------
# FW_WEBHOOK_SECRET=                        # shared secret for the signed pivot webhook (make up a long random one)
# LEAF_TOKEN=                               # Leaf (reads Lindsay FieldNET / Valley irrigation data)
# LEAF_USER_ID=

# --- Optional: where data lives and download tuning ---------------------------------------------------
# FW_DATA=                                  # default: ./data
# FW_S2S_FIRST=6,7,8                        # download these months' forecasts first
